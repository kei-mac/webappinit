<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kita.demo.mapper.DemoFileActionUtilMapper">
    <insert id="addDataMapper"> INSERT INTO ${tableName} <trim prefix="(" suffix=")" suffixOverrides=",">
            <foreach collection="map.keys" item="key" separator=","> ${key} </foreach>
        </trim>
        VALUES <trim prefix="(" suffix=")" suffixOverrides=",">
            <foreach collection="map.values" item="value" separator=","> #{value} </foreach>
        </trim>
    </insert>
</mapper>